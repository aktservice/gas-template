{
	"compilerOptions": {
		"target": "ES2019", // GAS V8エンジンに合わせてモダンかつ互換性のあるES2019に
		"lib": ["ES2019"], // バックエンドに DOM を含めない（MimeType 等の GAS 型が DOM と衝突するため）
		"module": "ESNext",
		"moduleResolution": "Bundler", // Vite/esbuildを使う場合の推奨設定
		"strict": true,
		"strictPropertyInitialization": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true, // 各ファイルを個別のモジュールとして扱う
		"noEmit": true, // 基本はビルドツール(Vite/esbuild)が変換するのでTSは型チェックのみ
		// 型定義の参照設定
		"typeRoots": [
			"./node_modules/@types",
			"./@types"
		],
		"types": [
			"google-apps-script",
			"jest",
			"node"
		]
	},
	"include": [
		"@types",
		"src/backend",
		"test",
		"boilerplate/*/src/backend",
		"boilerplate/infrastructure"
	],
	"exclude": [
		"@types/google-client.d.ts",
		"node_modules",
		"dist"
	]
}
